# Секреты функции «uploads». Один и тот же файл .env используется:
#  - для загрузки секретов в Supabase:  npx supabase secrets set --env-file .env --project-ref <ref>
#  - для настройки бакета:              npm run setup-bucket

# VK ID — тот же ID приложения, что VITE_VK_APP_ID на фронте
VK_APP_ID=

# VK Cloud Object Storage (кабинет VK Cloud → Объектное хранилище → Аккаунты → ключи доступа)
S3_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru
S3_REGION=ru-msk
S3_BUCKET=cse-contests
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Сайты, которым можно вызывать функцию и грузить файлы в бакет (через запятую)
CORS_ORIGINS=https://contests.cse-hr.ru,https://localhost

# Ограничения
MAX_FILE_SIZE_MB=2048
UPLOAD_URL_TTL_SECONDS=21600
